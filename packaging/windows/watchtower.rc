// Cilex Watchtower — Windows resource script.
// Compiled ONLY on WIN32 (added to the target inside the if(WIN32) block in the top-level
// CMakeLists.txt; enable_language(RC) is set there). Works with both MSVC rc.exe and MinGW windres.
#include <windows.h>

// Application manifest — NOT embedded here on Qt 6.12: qt_add_executable() auto-generates
// its own RT_MANIFEST (id 1) with PerMonitorV2 DPI + Win10/11 compat + UAC asInvoker, and
// embedding app.manifest here too caused a link-time "CVT1100: duplicate resource type:MANIFEST".
// We let Qt own the manifest. app.manifest is kept for reference / a future custom path
// (long-path awareness + UTF-8 active code page aren't in Qt's default — re-add in W4 via
// Qt's manifest customization or an mt.exe post-link step). See W1/W4 prompts.
// 1 24 "app.manifest"

// Application icon shown in the taskbar / title bar / Explorer.
// watchtower.ico generated from assets/images/cilex-logo.png (7 sizes 16..256) — see
// docs/plans/windows-port/W0-*.prompt.md (Pillow ICO export). The lowest numeric icon ID
// becomes the app's default (Explorer/taskbar) icon.
IDI_ICON1 ICON "watchtower.ico"

// Version information (Explorer → Properties → Details). Keep in sync with project(VERSION ...).
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,1,371,0
 PRODUCTVERSION 1,1,371,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"  // U.S. English (0x0409), Unicode (1200)
        BEGIN
            VALUE "CompanyName",      "Cilex Vision"
            VALUE "FileDescription",  "Cilex Watchtower \x2014 VMS operator client"
            VALUE "FileVersion",      "1.1.371.0"
            VALUE "InternalName",     "watchtower"
            VALUE "OriginalFilename", "watchtower.exe"
            VALUE "ProductName",      "Cilex Watchtower"
            VALUE "ProductVersion",   "1.1.371.0"
            VALUE "LegalCopyright",   "\xA9 Cilex Vision"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
