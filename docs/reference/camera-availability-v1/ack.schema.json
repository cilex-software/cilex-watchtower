{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AvailabilityAcknowledgementV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "backend_instance_id",
    "reporter_station_id",
    "server_received_at",
    "accepted_event_ids",
    "duplicate_event_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "backend_instance_id": {
      "type": "string",
      "format": "uuid"
    },
    "reporter_station_id": {
      "type": "string",
      "format": "uuid"
    },
    "batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "server_received_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_event_ids": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "duplicate_event_ids": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  }
}
