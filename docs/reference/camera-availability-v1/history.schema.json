{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "backend_instance_id",
    "events",
    "through_position",
    "next_cursor",
    "resume_cursor",
    "retention"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "backend_instance_id": {
      "type": "string",
      "format": "uuid"
    },
    "events": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "history-event.schema.json"
      }
    },
    "through_position": {
      "type": "integer",
      "minimum": 0
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4096
    },
    "resume_cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4096
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "automatic_deletion"
      ],
      "properties": {
        "mode": {
          "const": "indefinite"
        },
        "automatic_deletion": {
          "const": false
        }
      }
    }
  }
}
