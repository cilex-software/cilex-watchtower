#!/usr/bin/env bash
# Cilex Watchtower — bump the patch version on every commit.
#
# Policy (operator decision 2026-08-12): every commit that lands on GitHub gets
# its own version. 1.1.1, 1.1.2, 1.1.3 … Only the PATCH component moves; major
# and minor stay put until the operator says otherwise.
#
# The bumped files are added to THIS commit, so the version and the code it
# describes are always the same commit — there is no "version bump" commit
# trailing the change it names, and no commit that reuses its parent's number.
#
# Deliberately skipped, because in each of these the commit is not new work and
# a bump would either be wrong or would fight the operation in progress:
#   - merges, rebases, cherry-picks (the version already travelled with the commit)
#   - WT_NO_BUMP=1, the manual escape hatch
#
# NOT auto-detected: `git commit --amend`. Amending re-runs this hook and would
# bump a second time for one logical change. Use:  WT_NO_BUMP=1 git commit --amend
set -euo pipefail

[[ "${WT_NO_BUMP:-}" == "1" ]] && exit 0

GIT_DIR_PATH="$(git rev-parse --git-dir)"
for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
    [[ -e "$GIT_DIR_PATH/$marker" ]] && exit 0
done

ROOT="$(git rev-parse --show-toplevel)"
NEW="$("$ROOT/tools/bump-version.sh")"

# Stage only the files the bumper owns, and only those that actually changed —
# never `git add -A`, which would sweep unrelated work into someone's commit.
for f in CMakeLists.txt packaging/windows/watchtower.rc \
         packaging/windows/installer.nsi packaging/windows/app.manifest; do
    [[ -f "$ROOT/$f" ]] && ! git -C "$ROOT" diff --quiet -- "$f" && git -C "$ROOT" add -- "$f"
done

echo "watchtower: version -> $NEW"

# A NEW comment asserting how another system behaves must say when, or how we know.
# Diff-scoped, so it judges only what this commit ADDS and never inherits history.
# Calibrated 2026-09-23: 2 hits across the last 30 commits, both genuine.
# WT_NO_CLAIM_LINT=1 skips it, same escape hatch as the version bump.
if [[ "${WT_NO_CLAIM_LINT:-}" != "1" && -x "$ROOT/tools/tests/cross-system-claim-lint.py" ]]; then
    "$ROOT/tools/tests/cross-system-claim-lint.py" || exit 1
fi

# EventModel::pollMotion() must keep NOT sending exclude_types. Costs a regex over
# one file; prevents the live MOTION indicator going dark silently. The comment at
# the line asks a reader to notice; this asks the build to.
# WT_NO_MOTION_PIN=1 skips it.
if [[ "${WT_NO_MOTION_PIN:-}" != "1" && -x "$ROOT/tools/tests/motion-poll-unfiltered.py" ]]; then
    "$ROOT/tools/tests/motion-poll-unfiltered.py" >/dev/null || {
        "$ROOT/tools/tests/motion-poll-unfiltered.py"; exit 1; }
    echo "PASS  pollMotion() still unfiltered (motion indicator invariant)"
fi

# An `unknown` wall cell must not paint over the composited picture. On 2026-09-24
# a 16-camera wall showed sixteen empty hatched tiles and "0/16 RECORDING" while the
# composite was delivering frames the whole time: the cameras are `continuous`, so
# cellStateOf() answered `unknown` sixteen times -- correctly -- and WpCell drew an
# opaque hatch over every one. The verdict was honest; the rendering blacked out a
# working wall. WT_NO_WALL_UNKNOWN_PIN=1 skips it.
if [[ "${WT_NO_WALL_UNKNOWN_PIN:-}" != "1" && -x "$ROOT/tools/tests/wall-unknown-shows-picture.py" ]]; then
    "$ROOT/tools/tests/wall-unknown-shows-picture.py" >/dev/null || {
        "$ROOT/tools/tests/wall-unknown-shows-picture.py"; exit 1; }
    echo "PASS  an unknown wall cell still shows its picture"
fi

# The client must handle every recording state cilex-vision can emit. Its only live
# input to notRecordingCount is `stalled`, and its predecessor `not_recording` was
# already renamed once; a second rename would make three UI surfaces read all-clear
# during a real fleet failure. Skips cleanly where their checkout is absent.
# WT_NO_VOCAB_PIN=1 skips it.
if [[ "${WT_NO_VOCAB_PIN:-}" != "1" && -x "$ROOT/tools/tests/recording-vocab.py" ]]; then
    "$ROOT/tools/tests/recording-vocab.py" >/dev/null || {
        "$ROOT/tools/tests/recording-vocab.py"; exit 1; }
    echo "PASS  recording-state vocabulary still fully handled"
fi

# The B1 analyser is pure and its vocabulary is fixed by cilex-vision's migration
# 0084 CHECK constraint. 33 assertions including a replay of 220 real camera-slot rows.
# WT_NO_B1_TEST=1 skips it.
# A MISSING DEPENDENCY IS NOT A FAILED TEST. The Labs gates need numpy and cv2, and the
# Mac has neither, so until 2026-09-25 both gates FAILED there and the macOS agent had to
# set WT_NO_B1_TEST=1 WT_NO_WORKER_TEST=1 on every commit -- teaching the bypass, and a
# bypass left in a shell profile would skip them on a box that CAN run them too. So probe:
# absent deps print a visible SKIP and let the commit through; present deps run and gate.
labs_deps_ok() { python3 -c "import numpy, cv2" >/dev/null 2>&1; }
if [[ "${WT_NO_B1_TEST:-}" != "1" && -x "$ROOT/tools/tests/b1-illumination.py" ]] && ! labs_deps_ok; then
    echo "SKIP  B1 analyser test -- numpy/cv2 not installed on this box (not a failure)"
elif [[ "${WT_NO_B1_TEST:-}" != "1" && -x "$ROOT/tools/tests/b1-illumination.py" ]]; then
    "$ROOT/tools/tests/b1-illumination.py" >/dev/null || {
        "$ROOT/tools/tests/b1-illumination.py"; exit 1; }
    echo "PASS  B1 analyser ($("$ROOT/tools/tests/b1-illumination.py" 2>/dev/null | grep -c "^PASS") assertions, incl. a 220-row replay)"
fi

# The Labs worker: 35 hermetic assertions (no network, no DB, no live fleet), proven
# able to fail -- seven deliberate bugs, all seven killed. WT_NO_WORKER_TEST=1 skips it.
if [[ "${WT_NO_WORKER_TEST:-}" != "1" && -x "$ROOT/tools/tests/labs-worker.py" ]] && ! labs_deps_ok; then
    echo "SKIP  Labs worker test -- numpy/cv2 not installed on this box (not a failure)"
elif [[ "${WT_NO_WORKER_TEST:-}" != "1" && -x "$ROOT/tools/tests/labs-worker.py" ]]; then
    "$ROOT/tools/tests/labs-worker.py" >/dev/null || { "$ROOT/tools/tests/labs-worker.py"; exit 1; }
    echo "PASS  Labs worker ($("$ROOT/tools/tests/labs-worker.py" 2>/dev/null | grep -c "^PASS") hermetic assertions)"
fi

# frame_source must drain ffmpeg's stderr WHILE it reads frames. On 2026-09-26 a noisy
# segment (4.5 KB of warnings) filled Windows' ~4 KB pipe, ffmpeg blocked, and the
# worker's shared decode pass waited forever with no error. Invisible from Linux (64 KB
# pipes), so this pin writes 200 KB before any frame: it deadlocks on EVERY platform.
# It imports frame_source, which needs numpy and cv2, so it probes like the two gates
# above. Its first version (de07f2c) sat above them without the probe: on a box without
# numpy it exits 1, which fails the commit (simulated here with `python -S`).
# WT_NO_FS_STDERR_PIN=1 skips it.
if [[ "${WT_NO_FS_STDERR_PIN:-}" != "1" && -x "$ROOT/tools/tests/frame-source-stderr.py" ]] && ! labs_deps_ok; then
    echo "SKIP  frame_source stderr pin -- numpy/cv2 not installed on this box (not a failure)"
elif [[ "${WT_NO_FS_STDERR_PIN:-}" != "1" && -x "$ROOT/tools/tests/frame-source-stderr.py" ]]; then
    "$ROOT/tools/tests/frame-source-stderr.py" >/dev/null 2>&1 || {
        "$ROOT/tools/tests/frame-source-stderr.py"; exit 1; }
    echo "PASS  frame_source drains stderr while reading (no pipe deadlock)"
fi

# frame_source measures a segment's GOP from ONE demux pass (framecrc), not two decodes:
# 1.75 CPU-s against 27.67 on 28 -sub files on the booth, 2026-09-26. Safe only while
# framecrc still marks non-key packets with F= and packet counts equal decoded counts,
# so this pins both on a real clip where an ffmpeg works (SKIP otherwise). Same numpy/
# cv2 probe as above. WT_NO_FS_GOP_PIN=1 skips it.
if [[ "${WT_NO_FS_GOP_PIN:-}" != "1" && -x "$ROOT/tools/tests/frame-source-gop.py" ]] && ! labs_deps_ok; then
    echo "SKIP  frame_source GOP pin -- numpy/cv2 not installed on this box (not a failure)"
elif [[ "${WT_NO_FS_GOP_PIN:-}" != "1" && -x "$ROOT/tools/tests/frame-source-gop.py" ]]; then
    "$ROOT/tools/tests/frame-source-gop.py" >/dev/null 2>&1 || {
        "$ROOT/tools/tests/frame-source-gop.py"; exit 1; }
    echo "PASS  frame_source measures GOP by demux, and it matches the decoders"
fi

# A letter that ARRIVED from another agent gets its own commit, so its arrival is
# findable in the log. Peers write straight into this checkout's docs/letters/, and
# a blanket `git add -A` has twice buried one inside an unrelated commit.
# WT_NO_LETTER_LINT=1 skips it.
if [[ "${WT_NO_LETTER_LINT:-}" != "1" && -x "$ROOT/tools/tests/received-letter-lint.sh" ]]; then
    "$ROOT/tools/tests/received-letter-lint.sh" || exit 1
fi
