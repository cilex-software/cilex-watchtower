# wt-warden — supervises Cilex Watchtower on a guard workstation (Warden CW-07).
# USER unit: install to ~/.config/systemd/user/ (install-linux.sh does this),
#   systemctl --user enable --now wt-warden
# systemd keeps WARDEN alive; Warden keeps WATCHTOWER alive (parent-child, so
# exit causes are captured directly). Tied to the graphical session — the app
# needs the compositor.
[Unit]
Description=Watchtower Warden (supervisor + crash collector + uploader)
After=graphical-session.target
PartOf=graphical-session.target
# Never give up — a crash-looping Warden is Warden's own restart-loop policy's
# problem, not systemd's. This key belongs in [Unit]; in [Service] systemd logged
# "Unknown key name ... ignoring" and default rate-limiting silently applied
# (audit 2026-09-03, Medium 07).
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/lib/watchtower-warden/warden.py run
Restart=always
RestartSec=2
# The app inherits this: core dumps land in the crash dir (setup-root.sh sets
# kernel.core_pattern; without it collection still works, just core-less).
LimitCORE=infinity
# Sandboxing (audit 2026-09-03, Medium 07). Deliberately NOT ProtectHome: Warden,
# its spool, the app binary and the app's own data all live under ~, and the app
# needs the compositor socket in $XDG_RUNTIME_DIR. What is here cannot break a
# GUI child: no privilege escalation, no writes to the OS image, private /tmp,
# no raw sockets / packet sockets, no kernel tunables. NOT ProtectKernelModules:
# it needs CAP_SYS_MODULE to drop, which a USER unit cannot — measured 2026-09-06,
# "Failed to drop capabilities: Operation not permitted", crash loop.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=%h
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=graphical-session.target
