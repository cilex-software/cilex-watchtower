{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Qt 6.12 (primary)",
      "description": "Primary toolchain: Qt 6.12.0 / FFmpeg backend -> build/",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{HOME}/Qt/6.12.0/gcc_64",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "qt68",
      "displayName": "Qt 6.8.3 LTS (fallback)",
      "description": "Validated fallback: Qt 6.8.3 LTS (8.8h soak) -> build68/",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build68",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{HOME}/Qt/6.8.3/gcc_64",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "qt68", "configurePreset": "qt68" }
  ]
}
